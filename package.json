{
  "name": "synth",
  "version": "0.7.2",
  "type": "module",
  "bin": {
    "synth": "./src/cli.tsx"
  },
  "scripts": {
    "dev": "bun run src/cli.tsx",
    "build": "bun build src/cli.tsx --outdir dist --target bun",
    "build:binary": "bun build src/cli.tsx --compile --outfile dist/synth",
    "build:darwin-arm64": "bun build src/cli.tsx --compile --target bun-darwin-arm64 --outfile dist/synth-darwin-arm64",
    "build:darwin-x64": "bun build src/cli.tsx --compile --target bun-darwin-x64 --outfile dist/synth-darwin-x64",
    "build:linux-arm64": "bun build src/cli.tsx --compile --target bun-linux-arm64 --outfile dist/synth-linux-arm64",
    "build:linux-x64": "bun build src/cli.tsx --compile --target bun-linux-x64 --outfile dist/synth-linux-x64",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "bun test src/__tests__/",
    "bench": "bun scripts/bench.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": ["eslint --fix"]
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@opentui/core": "^0.1.72",
    "@opentui/react": "^0.1.72",
    "node-notifier": "^10.0.1",
    "react": "^19.2.0",
    "smol-toml": "^1.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node-notifier": "^8.0.5",
    "@types/react": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "bun-types": "^1.3.0",
    "eslint": "^10.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "typescript": "^5.9.0"
  }
}
