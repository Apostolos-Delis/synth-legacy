# Project config — personal prefs (agent, tui, parallel, notifications)
# go in your personal config: synth config --global --edit

[project]
name = "my-app"
branch = "feature/my-feature"

[execution]
max_iterations = 20
iteration_delay = 2000
auto_commit = true

[guardrails]
max_consecutive_failures = 3
backpressure_commands = ["bun run typecheck", "bun run lint"]

[finalize]
auto_format = true
split_commits = true
self_review = true
create_pr = true
